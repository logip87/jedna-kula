# Jedna kula: hosting Apache / cal.pl, root of a domain or subdomain.
DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Let browsers discover new releases and service worker updates.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

RewriteEngine On

# Serve real files and directories unchanged.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Missing static resources must return 404 instead of the app's HTML.
RewriteRule ^(?:assets|rule-sources)/ - [L]
RewriteRule \.[^/]+$ - [L]

# React Router: allow opening /adventure, /rules, etc. directly.
RewriteRule ^ index.html [L]
