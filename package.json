{
  "name": "jedna-kula",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy:setup": "python3 scripts/cal-ftp.py setup",
    "deploy:verify": "python3 scripts/cal-ftp.py verify",
    "deploy:check": "python3 scripts/cal-ftp.py check",
    "deploy": "npm run build && python3 scripts/cal-ftp.py upload",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json *.html docs/*.md README.md",
    "lint": "eslint src tests scripts/qa-generate.ts *.ts",
    "qa:contracts": "vitest run --config vitest.showcase.config.ts",
    "qa:browsers": "playwright test --config playwright.showcase.config.ts",
    "qa:showcase": "npm run qa:contracts && npm run qa:browsers",
    "qa:smoke": "npm run qa:browsers -- --grep @smoke",
    "qa:pwa": "npm run qa:browsers -- --project showcase-android --grep @pwa",
    "qa:a11y": "npm run qa:browsers -- --project showcase-android --grep @a11y",
    "qa:visual": "npm run qa:browsers -- --project visual-chromium --grep @visual",
    "qa:security": "npm run qa:browsers -- --project showcase-android --grep @security",
    "qa:agent-security": "vitest run --config vitest.showcase.config.ts tests/agent-security",
    "qa:agentic": "vitest run --config vitest.showcase.config.ts tests/agentic && npm run qa:browsers -- --project showcase-android --grep @agentic",
    "qa:resilience": "npm run qa:browsers -- --project showcase-android --grep @resilience",
    "qa:repeat": "npm run qa:browsers -- --project showcase-android --grep \"@smoke|@resilience\" --repeat-each=5",
    "qa:generate": "node --experimental-strip-types scripts/qa-generate.ts",
    "qa:generate:check": "npm run qa:generate -- --check",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.3"
  }
}
